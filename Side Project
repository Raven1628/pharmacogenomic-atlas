import requests
import pandas as pd

def query_gnomad(gene_name, dataset="gnomad_r4"):
    """Query gnomAD GraphQL API for variant frequencies in a gene"""
    url = "https://gnomad.broadinstitute.org/api"
    query = """
    query GeneVariants($geneSymbol: String!, $dataset: DatasetId!) {
      gene(gene_symbol: $geneSymbol, reference_genome: GRCh38) {
        variants(dataset: $dataset) {
          variant_id
          pos
          ref
          alt
          genome {
            af
            populations {
              id
              af
              ac
              an
            }
          }
        }
      }
    }
    """
    response = requests.post(url, json={
        "query": query,
        "variables": {"geneSymbol": gene_name, "dataset": dataset}
    })
    data = response.json()
    variants = data["data"]["gene"]["variants"]
    return pd.DataFrame(variants)

# Pull frequencies for key pharmacogenes
pharmacogenes = ["CYP2D6", "CYP2C19", "CYP2C9", "SLCO1B1", "DPYD"]
all_variants = {}

for gene in pharmacogenes:
    print(f"Fetching {gene}...")
    all_variants[gene] = query_gnomad(gene)
    
# Save to file
all_variants["CYP2D6"].to_csv("CYP2D6_gnomad_variants.csv", index=False)

